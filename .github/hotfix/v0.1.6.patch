+		return err
+	}
+	if err := os.Rename(tmp, metadataPath); err != nil {
+		_ = os.Remove(tmp)
+		return err
+	}
+	if refreshBaseline != nil {
+		return refreshBaseline()
+	}
+	return nil
+}
